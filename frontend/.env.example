# Kioni AI Bro - Frontend Environment Variables

# The base URL for the backend API (e.g., https://kioni-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# The base URL for the WebSocket (e.g., wss://kioni-backend.onrender.com/ws/chat)
# If not provided, it will be derived from VITE_API_URL
# VITE_WS_URL=ws://localhost:8000/ws/chat
